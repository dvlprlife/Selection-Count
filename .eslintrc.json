{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": "error",
    "semi": ["error", "always"],
    "curly": "error",
    "eqeqeq": ["error", "always"]
  },
  "ignorePatterns": ["dist", "node_modules", "**/*.d.ts"]
}
